# Root .gitignore for Physical-Engineering's Last Exam (PLE) Harness & Writeup

# OS & Environment junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~

# Python virtualenvs & build artifacts
.venv/
.venv*/
env/
venv/
ENV/
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# PLE Runtime & Benchmarking logs (Evaluator uses /tmp & scratch)
runs/
logs/
*.log
.cache/
.plebench/

# Scratch & Temporary experiments (scripts in scratch are tracked, but ignore temp runs/caches)
scratch/__pycache__/
scratch/*.tmp
scratch/*.log
scratch/*.swp

# IMPORTANT: Do NOT ignore artifacts/ (must be committed for Stage 1 evaluation)
!artifacts/
